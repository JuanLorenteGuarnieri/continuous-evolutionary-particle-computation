{
  "name": "cepc-monorepo",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "test": "pnpm --filter=./src/* test",
    "lint": "pnpm --filter=./src/* lint",
    "typecheck": "pnpm --filter=./src/* --if-present typecheck",
    "build": "pnpm --filter=./src/react-ui build",
    "deploy": "pnpm --filter=./src/react-ui run build",
    "test:webgpu-validation": "node -e \"console.log('WebGPU validation stub passed')\"",
    "test:webgpu-mfm-validation": "node -e \"console.log('WebGPU MFM validation stub passed')\"",
    "test:experiment-integration": "node -e \"console.log('Experiment integration stub passed')\"",
    "test:cross-validate": "node tests/behavioral/run-tests.js",
    "test:behavioral": "pnpm --filter @cepc/behavioral-tests test",
    "validate:subset": "node tools/validate-trajectory.js configs/experiments/P0-manifest.json",
    "validate:full": "node -e \"console.log('validate full stub passed')\"",
    "benchmark": "npm run benchmark:cpu",
    "benchmark:cpu": "node --no-warnings --experimental-strip-types --experimental-loader=./tools/bench/ts-prefer-loader.mjs tools/bench/cpu-benchmark.mjs",
    "benchmark:webgpu": "node tools/bench/benchmark-webgpu.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3"
  }
}
