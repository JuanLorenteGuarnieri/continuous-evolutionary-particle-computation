 {
   "version": "3.0.0",
   "experimentId": "RegimeClassification",
   "description": "Controlled frequency/regime classification",
   "mfmConfig": {
     "version": "3.0.0",
     "Lx": 100,
     "Ly": 100,
     "Nmax": 300,
     "dt": 0.1,
     "seed": 105,
     "Qmax": 1000,
     "R_s_min": 0.5,
     "R_s_max": 5.0,
     "boundary": "periodic"
   },
   "experimentConfig": {
     "version": "3.0.0",
     "duration": 2000,
     "checkpointInterval": 100,
     "errorMeasure": "accuracy",
     "readout": {"type": "classifier"}
   },
   "inputSignal": {"type": "frequency", "values": [0.5, 1.0, 2.0]},
   "outputReadout": {"type": "classification"},
   "duration": 2000,
     "checkpointInterval": 100,
     "metricsToCollect": ["accuracy", "confusionMatrix"]
 }
