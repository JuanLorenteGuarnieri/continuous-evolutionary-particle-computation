 {
   "version": "3.0.0",
   "experimentId": "DamageRecovery",
   "description": "Damage and recovery simulations",
   "mfmConfig": {
     "version": "3.0.0",
     "Lx": 100,
     "Ly": 100,
     "Nmax": 300,
     "dt": 0.1,
     "seed": 109,
     "Qmax": 1000,
     "R_s_min": 0.5,
     "R_s_max": 5.0,
     "boundary": "periodic"
   },
   "experimentConfig": {
     "version": "3.0.0",
     "duration": 3000,
     "checkpointInterval": 100,
     "errorMeasure": "mse",
     "readout": {"type": "linear"}
   },
   "inputSignal": {"type": "damage", "time": 1500, "fraction": 0.3},
   "outputReadout": {"type": "prediction"},
   "duration": 3000,
     "checkpointInterval": 100,
     "metricsToCollect": ["predictionError", "recoveryTime", "populationRecovery"]
 }
