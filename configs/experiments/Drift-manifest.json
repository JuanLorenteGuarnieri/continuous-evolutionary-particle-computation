 {
   "version": "3.0.0",
   "experimentId": "Drift",
   "description": "Gradual drift in input statistics",
   "mfmConfig": {
     "version": "3.0.0",
     "Lx": 100,
     "Ly": 100,
     "Nmax": 300,
     "dt": 0.1,
     "seed": 107,
     "Qmax": 1000,
     "R_s_min": 0.5,
     "R_s_max": 5.0,
     "boundary": "periodic"
   },
   "experimentConfig": {
     "version": "3.0.0",
     "duration": 3000,
     "checkpointInterval": 100,
     "errorMeasure": "mse",
     "readout": {"type": "linear"}
   },
   "inputSignal": {"type": "drift", "start": 0.0, "end": 1.0},
   "outputReadout": {"type": "prediction"},
   "duration": 3000,
     "checkpointInterval": 100,
     "metricsToCollect": ["predictionError", "adaptationSpeed"]
 }
