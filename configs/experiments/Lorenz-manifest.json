 {
   "version": "3.0.0",
   "experimentId": "Lorenz",
   "description": "Lorenz chaotic system prediction",
   "mfmConfig": {
     "version": "3.0.0",
     "Lx": 100,
     "Ly": 100,
     "Nmax": 300,
     "dt": 0.1,
     "seed": 104,
     "Qmax": 1000,
     "R_s_min": 0.5,
     "R_s_max": 5.0,
     "boundary": "periodic"
   },
   "experimentConfig": {
     "version": "3.0.0",
     "duration": 3000,
     "checkpointInterval": 100,
     "errorMeasure": "mse",
     "readout": {"type": "linear"}
   },
   "inputSignal": {"type": "lorenz", "params": {"sigma": 10, "rho": 28, "beta": 8/3}},
   "outputReadout": {"type": "prediction", "horizon": 1},
   "duration": 3000,
     "checkpointInterval": 100,
     "metricsToCollect": ["predictionError", "correlation"]
 }
